[Unit]
Description=Sunspec Solar task board
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sunspec
Group=sunspec
WorkingDirectory=/opt/sunspec-taskboard
EnvironmentFile=/opt/sunspec-taskboard/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/sunspec-taskboard/data
UMask=0077

[Install]
WantedBy=multi-user.target
