PORT=8082
SESSION_SECRET=replace-with-a-long-random-string
DB_PATH=./data/taskboard.sqlite
DATA_DIR=./data

# Used only to create the first account (a superuser) when the database has no users.
# You can remove ADMIN_PASSWORD after the account exists.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-long-password
ADMIN_NAME=Superuser
